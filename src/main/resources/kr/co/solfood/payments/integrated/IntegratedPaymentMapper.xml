<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.co.solfood.payments.integrated.IntegratedPaymentMapper">

    <resultMap id="IntegratedPaymentMap" type="kr.co.solfood.payments.integrated.IntegratedPaymentVO">
        <id property="integratedpaymentId" column="integratedpayment_id"/>
        <result property="storeId" column="store_id"/>
        <result property="integratedpaymentLeaderId" column="integratedpayment_leader_id"/>
        <result property="integratedpaymentAmount" column="integratedpayment_amount"/>
        <result property="integratedpaymentPeople" column="integratedpayment_people"/>
        <result property="integratedpaymentStatus" column="integratedpayment_status"/>
        <result property="integratedpaymentCreatedAt" column="integratedpayment_created_at"/>
        <result property="integratedpaymentUpdatedAt" column="integratedpayment_updated_at"/>
    </resultMap>

    <!-- 통합 결제 생성 -->
    <insert id="insertIntegratedPayment" parameterType="kr.co.solfood.payments.integrated.IntegratedPaymentVO" 
            useGeneratedKeys="true" keyProperty="integratedpaymentId">
        INSERT INTO integrated_payment (
            store_id,
            integratedpayment_leader_id,
            integratedpayment_amount,
            integratedpayment_people,
            integratedpayment_status
        ) VALUES (
            #{storeId},
            #{integratedpaymentLeaderId},
            #{integratedpaymentAmount},
            #{integratedpaymentPeople},
            #{integratedpaymentStatus}
        )
    </insert>

    <!-- ID로 통합 결제 조회 -->
    <select id="selectIntegratedPaymentById" resultMap="IntegratedPaymentMap">
        SELECT * FROM integrated_payment 
        WHERE integratedpayment_id = #{integratedPaymentId}
    </select>

    <!-- 발의자 ID로 통합 결제 조회 -->
    <select id="selectIntegratedPaymentByLeaderId" resultMap="IntegratedPaymentMap">
        SELECT * FROM integrated_payment 
        WHERE integratedpayment_leader_id = #{leaderId}
        ORDER BY integratedpayment_created_at DESC
        LIMIT 1
    </select>

</mapper> 